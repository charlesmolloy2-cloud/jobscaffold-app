# Development uses the local demo-jobscaffold emulators automatically.
# Enable the same emulator connection for a production build used in local tests.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# Override this host if the emulator ports are forwarded through another host.
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# Firebase CLI emulators require Java 21 or newer.
